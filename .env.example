# Copia este archivo a ".env" y rellena tus valores.

# Dominio con el que vas a acceder a la app (necesario para el HTTPS automático).
DOMAIN=trailcoach.tudominio.com

# Cadena aleatoria para firmar las sesiones (cada persona tiene su propia cuenta con email y
# contraseña; esto firma sus tokens de sesión). Genera una con: openssl rand -hex 32
SESSION_SECRET=cambia-esto

# Zona horaria del atleta (para que "hoy" sea siempre tu hoy real).
TZ_ATHLETE=Europe/Madrid

# --- Opcional: ajustes con IA en lenguaje natural (Claude) ---
# Clave de https://console.anthropic.com/ (Configuración > API Keys).
ANTHROPIC_API_KEY=

# --- Opcional: sincronización automática con Strava ---
# Se crean en https://www.strava.com/settings/api (ver README, sección Strava).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://trailcoach.tudominio.com/api/strava/callback

# --- Necesario para que "recuperar contraseña" llegue de verdad al usuario ---
# Sin esto configurado, el enlace de recuperación solo queda escrito en el log del servidor:
# funciona para probarlo tú mismo, pero NO le llega el correo a un usuario real. Cualquier
# proveedor SMTP normal vale (Resend, Brevo/Sendinblue, Amazon SES, tu propio Gmail con
# contraseña de aplicación...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ULTRALAB - TRAILCOACH <no-reply@trailcoach.tudominio.com>

# --- Opcional: cobrar la suscripción con Stripe (ver README, sección Stripe) ---
# Sin STRIPE_SECRET_KEY + STRIPE_PRICE_MONTHLY configurados, la app no exige pago: todo el mundo
# entrena gratis. En cuanto los pones, la prueba gratuita de 14 días empieza a aplicarse de verdad
# y hace falta suscribirse (o cancelar la cuenta) al terminarla.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=
